# Dependencias
node_modules/

# Variables de entorno
.env
.env.local

# Builds
dist/
build/
# Frontend compilado por el build raíz (npm run build lo regenera por completo en cada corrida)
server/client/

# Logs
*.log
npm-debug.log*

# Sistema
.DS_Store
Thumbs.db

# Uploads
server/uploads/*
!server/uploads/.gitkeep

# Configuración de deploy con secretos (AUDIT-001) — usar variables de entorno reales, no archivos
web.config
server/web.config

# Respaldos/scripts internos que no deben vivir dentro de server/ (es la carpeta que se sube por FTP).
# Ver scripts/check-deploy-safety.js — bloquea el build si aparece alguno de estos patrones ahí.
server/update-admin.js
server/version-check*.js
server/web.config.version-check
*.tar.gz
*.tar.gz.backup
*.backup
*.bak
