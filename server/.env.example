PORT=3001
NODE_ENV=development
# Nivel de log de winston (utils/logger.js) — opcional, por defecto 'info' si se omite
LOG_LEVEL=info

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=triomphe_db
DB_USER=root
DB_PASSWORD=

# JWT — ambas variables son obligatorias, el servidor no arranca si faltan (ver
# src/config/validateEnv.js). JWT_SECRET debe tener al menos 32 caracteres y no puede ser
# un valor trivial/de ejemplo; genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# URLs permitidas para CORS (producción: dominio SmarterASP o dominio propio)
# Múltiples orígenes separados por coma si aplica
CLIENT_URL=http://localhost:5173
# CLIENT_URLS=https://tu-dominio.com,https://www.tu-dominio.com

# Email (Gmail con App Password)
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# Cloudinary (subida de imágenes y documentos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp (Meta Cloud API) — opcional, la app funciona sin esto
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_ALERT=alerta_propiedad
WHATSAPP_TEMPLATE_FOLLOWUP=seguimiento_lead
